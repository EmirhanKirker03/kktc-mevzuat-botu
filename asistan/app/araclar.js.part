/* ================= avukat araçları ================= */
const AR = JSON.parse(document.getElementById('araclar').textContent);
const yerel = { al(k, v){ try{ const s=localStorage.getItem(k); return s?JSON.parse(s):v; }catch(_){ return v; } }, koy(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); return true; }catch(_){ return false; } } };
const hataMesaj = e => ({not_granted:'Bu sayfanın Claude kullanmasına izin verilmedi.',rate_limited:'Çok fazla istek; biraz sonra deneyin.',cancelled:'',invalid_json:'Cevap okunamadı; tekrar deneyin.',prompt_too_large:'Metin çok uzun; daha kısa bir bölüm deneyin.',sampling_disabled:'Bu hesapta yapay zekâ kullanılamıyor.'})[e&&e.code] ?? 'Bağlantı sorunu; tekrar deneyin.';

/* ---------- dosya indirme: claude.ai'de "downloads", kendi sunucumuzda doğrudan indirme ---------- */
let DL = null;
if(window.claude && window.claude.use) window.claude.use('downloads').then(d=>{ DL=d; }).catch(()=>{});
async function indir(ad, veri){
  const blob = veri instanceof Blob ? veri : new Blob([veri], {type:'text/plain;charset=utf-8'});
  if(DL){ try{ await DL.save({filename:ad, data:blob}); return 'ok'; }catch(e){ if(e && e.code==='declined') return 'iptal'; if(e && (e.code==='rejected_extension'||e.code==='extension_not_enabled')) return 'tur'; if(e && e.code==='rate_limited') return 'bekle'; } }
  try{ const u=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=u; a.download=ad; a.rel='noopener'; a.style.display='none'; document.body.append(a); a.click(); setTimeout(()=>{ a.remove(); URL.revokeObjectURL(u); }, 30000); return 'ok'; }catch(_){ return 'hata'; }
}
const indirMesaj = r => ({ok:'', iptal:'İndirme iptal edildi.', tur:'Bu görünümde bu dosya türü indirilemiyor.', bekle:'Bir indirme penceresi zaten açık.', hata:'Dosya indirilemedi.'})[r] || '';
const dosyaAdi = s => (String(s).replace(/[çğıöşüâîûÇĞİÖŞÜÂÎÛ]/g,c=>({ç:'c',ğ:'g',ı:'i',ö:'o',ş:'s',ü:'u',â:'a',î:'i',û:'u',Ç:'C',Ğ:'G',İ:'I',Ö:'O',Ş:'S',Ü:'U',Â:'A',Î:'I',Û:'U'}[c])).replace(/[^A-Za-z0-9 ._()-]+/g,' ').replace(/\s+/g,' ').trim().slice(0,70) || 'belge');

/* Word (.docx): sıkıştırmasız zip içinde en küçük geçerli belge */
const CRCT = (()=>{ const t=new Uint32Array(256); for(let n=0;n<256;n++){ let c=n; for(let k=0;k<8;k++) c = c&1 ? 0xEDB88320^(c>>>1) : c>>>1; t[n]=c>>>0; } return t; })();
function crc32(b){ let c=0xFFFFFFFF; for(let i=0;i<b.length;i++) c=CRCT[(c^b[i])&255]^(c>>>8); return (c^0xFFFFFFFF)>>>0; }
function zipla(dosyalar, tip){
  const te=new TextEncoder(), parca=[], merkez=[]; let ofs=0;
  dosyalar.forEach(f=>{
    const ad=te.encode(f.ad), d=typeof f.veri==='string'?te.encode(f.veri):f.veri, c=crc32(d);
    const h=new DataView(new ArrayBuffer(30));
    h.setUint32(0,0x04034b50,true); h.setUint16(4,20,true); h.setUint16(6,0x0800,true); h.setUint16(8,0,true); h.setUint16(10,0,true); h.setUint16(12,0x21,true);
    h.setUint32(14,c,true); h.setUint32(18,d.length,true); h.setUint32(22,d.length,true); h.setUint16(26,ad.length,true); h.setUint16(28,0,true);
    parca.push(new Uint8Array(h.buffer), ad, d);
    const m=new DataView(new ArrayBuffer(46));
    m.setUint32(0,0x02014b50,true); m.setUint16(4,20,true); m.setUint16(6,20,true); m.setUint16(8,0x0800,true); m.setUint16(10,0,true); m.setUint16(12,0,true); m.setUint16(14,0x21,true);
    m.setUint32(16,c,true); m.setUint32(20,d.length,true); m.setUint32(24,d.length,true); m.setUint16(28,ad.length,true);
    m.setUint16(30,0,true); m.setUint16(32,0,true); m.setUint16(34,0,true); m.setUint16(36,0,true); m.setUint32(38,0,true); m.setUint32(42,ofs,true);
    merkez.push(new Uint8Array(m.buffer), ad); ofs += 30+ad.length+d.length;
  });
  const ml=merkez.reduce((s,x)=>s+x.length,0), son=new DataView(new ArrayBuffer(22));
  son.setUint32(0,0x06054b50,true); son.setUint16(8,dosyalar.length,true); son.setUint16(10,dosyalar.length,true); son.setUint32(12,ml,true); son.setUint32(16,ofs,true);
  return new Blob([...parca, ...merkez, new Uint8Array(son.buffer)], {type:tip});
}
// bloklar: [{tur:'h1'|'h2'|'p'|'alinti'|'kucuk'|'orta', metin, kalin}]
function docx(baslik, bloklar){
  const x=s=>String(s).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const ST={h1:{b:1,sz:30,j:'center'},h2:{b:1,sz:25},orta:{b:1,j:'center'},p:{},alinti:{i:1,sz:22},kucuk:{sz:18,renk:'555555'}};
  const run=(t,o)=>'<w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>'+(o.b?'<w:b/>':'')+(o.i?'<w:i/>':'')+'<w:sz w:val="'+(o.sz||24)+'"/>'+(o.renk?'<w:color w:val="'+o.renk+'"/>':'')+'</w:rPr><w:t xml:space="preserve">'+x(t)+'</w:t></w:r>';
  const par=b=>{ const o={...(ST[b.tur]||{})}; if(b.kalin) o.b=1;
    return '<w:p><w:pPr>'+(o.j?'<w:jc w:val="'+o.j+'"/>':'<w:jc w:val="both"/>')+'<w:spacing w:after="140" w:line="300" w:lineRule="auto"/>'+(b.tur==='alinti'?'<w:ind w:left="567"/>':'')+'</w:pPr>'+
      String(b.metin).split('\n').map((s,i)=>(i?'<w:r><w:br/></w:r>':'')+run(s,o)).join('')+'</w:p>'; };
  const govde='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body>'+bloklar.map(par).join('')+
    '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1418" w:right="1418" w:bottom="1418" w:left="1418" w:header="709" w:footer="709" w:gutter="0"/></w:sectPr></w:body></w:document>';
  return zipla([
    {ad:'[Content_Types].xml', veri:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/docProps/core.xml" ContentType="application/vnd.openxmlformats-package.core-properties+xml"/></Types>'},
    {ad:'_rels/.rels', veri:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/></Relationships>'},
    {ad:'docProps/core.xml', veri:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>'+x(baslik)+'</dc:title><dc:creator>KKTC Hukuk Asistanı</dc:creator></cp:coreProperties>'},
    {ad:'word/document.xml', veri:govde}
  ], 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
}
window.__docx = docx; // yalnızca otomatik testler için
async function kopyala(metin, durumEl){
  try{ await navigator.clipboard.writeText(metin); if(durumEl) durumEl.textContent='Panoya kopyalandı.'; }
  catch(_){ const t=document.createElement('textarea'); t.value=metin; t.setAttribute('readonly',''); t.style.position='fixed'; t.style.opacity='0'; document.body.append(t); t.select(); let ok=false; try{ ok=document.execCommand('copy'); }catch(__){} t.remove(); if(durumEl) durumEl.textContent = ok?'Panoya kopyalandı.':'Kopyalanamadı; metni seçip kopyalayın.'; }
}
const etiket = c => { const a=BYCID[c]; if(!a) return c; const L=LAWBY[a.law]; const n=String(a.no); return L.kisa+' '+(n.startsWith('Geçici')?n.replace('Geçici','geç.'):/^(Parça|Değişiklik)/.test(n)?n.toLowerCase():'m.'+n); };
const bugunStr = () => new Date().toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'});

/* ---------- cevap: kopyala, Word, geçmiş, takip sorusu ---------- */
let SONCEVAP = null, SOHBET = [];
const GKEY='kktc-gecmis-v1';
function cevapMetni(c){
  const sat=['Soru: '+c.q, '', c.res.summary||''];
  let bol=''; c.v.kept.forEach(k=>{ if(k.section && k.section!==bol){ bol=k.section; sat.push('', bol.toLocaleUpperCase('tr')); } sat.push('- '+k.text+' ['+k.cites.map(etiket).join('; ')+']'); });
  if(c.res.limits) sat.push('', 'Ayrıca kontrol edin: '+c.res.limits);
  if(c.vc && c.vc.ok.length){ sat.push('', 'Yüksek Mahkeme kararlarından:'); c.vc.ok.forEach(k=>sat.push('- '+k.finding+' ('+k.k.tur+', '+trDate(k.k.tarih)+') “'+k.quote+'”')); }
  sat.push('', 'KKTC Hukuk Asistanı · '+bugunStr()+' · Yapay zekâ taslağıdır; dayanılan metinleri kontrol edin.');
  return sat.join('\n');
}
function cevapWord(c){
  const B=[{tur:'h1',metin:'Araştırma Notu'},{tur:'kucuk',metin:bugunStr()+' · KKTC Hukuk Asistanı'},{tur:'h2',metin:'Soru'},{tur:'p',metin:c.q},{tur:'h2',metin:'Cevap'},{tur:'p',metin:c.res.summary||''}];
  let bol=''; c.v.kept.forEach(k=>{ if(k.section && k.section!==bol){ bol=k.section; B.push({tur:'h2',metin:bol}); } B.push({tur:'p',metin:'• '+k.text+' ['+k.cites.map(etiket).join('; ')+']'}); });
  if(c.res.limits) B.push({tur:'p',metin:'Ayrıca kontrol edin: '+c.res.limits,kalin:false});
  if(c.vc && c.vc.ok.length){ B.push({tur:'h2',metin:'Yüksek Mahkeme kararları'}); c.vc.ok.forEach(k=>{ B.push({tur:'p',metin:'• '+k.finding+' ('+k.k.tur+', '+trDate(k.k.tarih)+(k.k.taraflar?', '+k.k.taraflar:'')+')'}); B.push({tur:'alinti',metin:'“'+k.quote+'”'}); }); }
  const kul=[...new Set(c.v.kept.flatMap(k=>k.cites))].map(x=>BYCID[x]).filter(Boolean);
  if(kul.length){ B.push({tur:'h2',metin:'Dayanılan maddeler'}); kul.forEach(a=>{ const L=LAWBY[a.law]; B.push({tur:'p',kalin:true,metin:L.ad+' ('+L.no+') — '+mLabel(a)+(a.title?' · '+a.title:'')}); B.push({tur:'alinti',metin:a.text.length>6000?a.text.slice(0,6000)+' […]':a.text}); B.push({tur:'kucuk',metin:'Kaynak: '+(a.sd?'Meclis arşivi (değişiklik yasası)':L.otomatik?'Yüksek Mahkeme birleştirilmiş metni, madde sınırları otomatik':'Yüksek Mahkeme / Meclis resmî metni')+(L.url?' · '+L.url:'')}); }); }
  B.push({tur:'kucuk',metin:'Bu not yapay zekâ yardımıyla hazırlanmıştır ve hukuki görüş değildir. Kullanmadan önce dayanılan metinleri resmî kaynaktan kontrol edin.'});
  return docx('Araştırma Notu', B);
}
function cevapEylem(q, res, v, vc, list){
  SONCEVAP = {q, res, v, vc, list};
  const kutu = document.querySelector('#answer .answer'); if(!kutu) return;
  if(v.kept.length){
    const d=document.createElement('div'); d.className='acts';
    d.innerHTML='<button class="btn ghost sm" type="button" data-act="kopya">Kopyala</button><button class="btn ghost sm" type="button" data-act="word">Word olarak indir</button><span class="state small" data-act-durum></span>';
    kutu.append(d);
    const g=yerel.al(GKEY,[]); g.unshift({t:Date.now(), q, metin:cevapMetni(SONCEVAP)}); yerel.koy(GKEY, g.slice(0,60));
    SOHBET.push({q, ozet:((res.summary||'')+'\n'+v.kept.map(k=>'- '+k.text).join('\n')).slice(0,1800)}); SOHBET=SOHBET.slice(-3);
    $('#devam').hidden=false; $('#q').value=''; $('#q').placeholder='Takip sorusu yazın (ör. Peki süre ne zaman başlar?)';
    gecmisCiz();
  }
}
$('#answer').addEventListener('click', async e=>{
  const b=e.target.closest('[data-act]'); if(!b || !SONCEVAP) return;
  const dur=b.parentElement.querySelector('[data-act-durum]');
  if(b.dataset.act==='kopya') kopyala(cevapMetni(SONCEVAP), dur);
  if(b.dataset.act==='word'){ dur.textContent='Hazırlanıyor…'; const r=await indir(dosyaAdi('Araştırma notu - '+SONCEVAP.q)+'.docx', cevapWord(SONCEVAP)); dur.textContent=indirMesaj(r)||'Word dosyası indirildi.'; }
});
$('#yenikonu').addEventListener('click',()=>{ SOHBET=[]; $('#devam').hidden=true; $('#q').placeholder='Sorunuzu yazın. Örn. Ev sahibi kirayı artırmak istiyor, anlaşamazsak ne olur?'; $('#q').focus(); });
function gecmisCiz(){
  const g=yerel.al(GKEY,[]); $('#gsay').textContent=g.length?String(g.length):'';
  $('#glist').innerHTML = g.length ? g.map((x,i)=>'<button type="button" class="grow" data-g="'+i+'"><span>'+esc(x.q)+'</span><span class="muted small">'+new Date(x.t).toLocaleString('tr-TR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})+'</span></button>').join('')
    : '<p class="muted small" style="margin:0">Henüz kayıtlı soru yok. Cevaplanan sorular burada, yalnızca bu cihazda tutulur.</p>';
}
$('#gbtn').addEventListener('click',()=>{ const p=$('#gecmis'); p.hidden=!p.hidden; $('#gbtn').setAttribute('aria-expanded',String(!p.hidden)); if(!p.hidden) gecmisCiz(); });
$('#glist').addEventListener('click',e=>{ const b=e.target.closest('[data-g]'); if(!b) return; const x=yerel.al(GKEY,[])[+b.dataset.g]; if(!x) return;
  $('#gecmis').hidden=true; $('#pane-ask').classList.add('sorulmus'); $('#q').value=x.q;
  $('#answer').innerHTML='<div class="answer"><h2>Geçmişten</h2><p class="small muted">'+esc(new Date(x.t).toLocaleString('tr-TR'))+' tarihli cevap. Mevzuat değişmiş olabilir; güncel cevap için yeniden sorun.</p><pre class="gtxt">'+esc(x.metin)+'</pre><div class="acts"><button class="btn sm" type="button" id="gyeniden">Yeniden sor</button><button class="btn ghost sm" type="button" id="gkopya">Kopyala</button><span class="state small" id="gdur"></span></div></div>';
  $('#gyeniden').onclick=()=>{ SOHBET=[]; $('#devam').hidden=true; run(); }; $('#gkopya').onclick=()=>kopyala(x.metin,$('#gdur')); });
$('#gsil').addEventListener('click',()=>{ yerel.koy(GKEY,[]); gecmisCiz(); });
gecmisCiz();

/* ---------- derin araştırma: soruyu alt sorulara böl, her birini ara ---------- */
async function derinPlan(q, onceki, sig){
  const plan = await sampleFn.json(`Bir KKTC avukatının sorusunu araştırmak için 3-5 alt soruya böl. Her alt soru, KKTC yasa ve tüzüklerinde aranacak kısa bir arama ifadesi olsun. KKTC terimlerini kullan (ör. istinaf, tahliye emri, ara emri, celpname, talep takriri, Kaza Mahkemesi). Türkiye mevzuatı terimleri (TBK, HMK, İİK) kullanma. Kural, istisna, usul ve süre yönlerini ayrı ayrı düşün.
${onceki}
SORU: ${q}

Yalnızca JSON döndür: {"alt":["...","..."]}`, {signal:sig, modelTier:'default'});
  return (Array.isArray(plan&&plan.alt)?plan.alt:[]).map(String).map(s=>s.trim()).filter(s=>s.length>2).slice(0,5);
}
async function cokluAra(ifadeler, sinir, durum){
  const goruldu=new Set(), out=[];
  for(const s of ifadeler){ if(durum) durum('Aranıyor: '+s.slice(0,70)); let r=[]; try{ r=await birlesik(s,5); }catch(_){ r=search(s); }
    r.forEach(a=>{ if(!goruldu.has(a.cid) && out.length<sinir){ goruldu.add(a.cid); out.push(a); } }); }
  return out;
}

/* ---------- süre hesaplayıcı ---------- */
const GUNAD=['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
const tUTC = s => { const [y,m,d]=s.split('-').map(Number); return new Date(Date.UTC(y,m-1,d)); };
const iso = d => d.toISOString().slice(0,10);
const trd = d => d.getUTCDate()+' '+['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'][d.getUTCMonth()]+' '+d.getUTCFullYear()+' '+GUNAD[d.getUTCDay()];
const gunEkle = (d,n) => new Date(d.getTime()+n*864e5);
const ayEkle = (d,n) => { const y=d.getUTCFullYear(), m=d.getUTCMonth()+n, g=d.getUTCDate(), son=new Date(Date.UTC(y,m+1,0)).getUTCDate(); return new Date(Date.UTC(y,m,Math.min(g,son))); };
const TKEY='kktc-tatil-v1', SKEY='kktc-sureler-v1';
let DEGT = yerel.al(TKEY,[]);
function tatilMi(d){ const s=AR.tatil.sabit.find(x=>x[0]===iso(d).slice(5)); if(s) return s[1]; const e=DEGT.find(x=>x.t===iso(d)); return e?e.ad:''; }
const sayilmaz = d => d.getUTCDay()===0 ? 'Pazar' : tatilMi(d);
function sureHesap(r, bas){
  const adim=[]; let son;
  const gun = r.birim==='gun' ? r.miktar : r.birim==='hafta' ? r.miktar*7 : null;
  if(gun!==null && gun<=6){
    let d=bas, say=0; adim.push('Başlangıç günü ('+trd(bas)+') sayılmaz — m.31(A).');
    while(say<gun){ d=gunEkle(d,1); const n=sayilmaz(d); if(n){ adim.push(trd(d)+' sayılmadı ('+n+') — m.31(D), süre altı günü geçmiyor.'); continue; } say++; }
    son=d; adim.push(gun+' gün sayıldı: '+trd(son)+'.');
  } else if(gun!==null){ son=gunEkle(bas,gun); adim.push('Başlangıç günü ('+trd(bas)+') sayılmaz — m.31(A). '+(r.birim==='hafta'?r.miktar+' hafta = ':'')+gun+' gün eklendi: '+trd(son)+'.'); }
  else { son=ayEkle(bas,r.miktar); adim.push(r.miktar+' ay eklendi: '+trd(son)+'. Ay, takvim ayı olarak hesaplandı; bu hesap yöntemini kontrol edin.'); }
  let k=0; while(sayilmaz(son) && k<12){ const n=sayilmaz(son); son=gunEkle(son,1); k++; adim.push('Son gün '+n+' olduğu için süre ertesi güne uzar: '+trd(son)+' — m.31(B).'); }
  const uyari=[];
  if(son.getUTCDay()===6) uyari.push('Son gün Cumartesi. Yorum Yasası m.31(B) yalnızca Pazar ve resmî tatili sayar; Cumartesi için uzama öngörmez. Mukayyitliğin o gün işlem yapıp yapmadığını kontrol edin.');
  for(let d=gunEkle(bas,1); d<=son; d=gunEkle(d,1)){ const md=iso(d).slice(5); if(md>='07-01' && md<='09-15'){ uyari.push('Süre adli tatile denk geliyor (1 Temmuz–15 Eylül, '+AR.adli.kaynak+'). Bu araçtaki metinlerde adli tatilin bu süreyi durdurduğuna dair bir kural bulunamadı; uygulamayı kontrol edin.'); break; } }
  const yillar=new Set(); for(let d=bas; d<=son; d=gunEkle(d,1)) yillar.add(d.getUTCFullYear());
  const eksik=[...yillar].filter(y=>!DEGT.some(x=>x.t.startsWith(String(y))));
  if(eksik.length) uyari.push(eksik.join(', ')+' yılı için bayram (Şeker, Kurban) ve Mevlit tarihleri girilmedi; bu günlere düşen son gün hesaba katılmadı. Aşağıdaki “Değişken tatiller” bölümünden ekleyin.');
  return {son, adim, uyari};
}
function kalanGun(sonIso){ const b=new Date(); const bu=Date.UTC(b.getFullYear(),b.getMonth(),b.getDate()); return Math.round((tUTC(sonIso).getTime()-bu)/864e5); }
function kalanYazi(n){ return n<0 ? (-n)+' gün geçti' : n===0 ? 'bugün son gün' : n+' gün kaldı'; }
let SUREHAZIR=false, SONHESAP=null;
function sureInit(){
  if(SUREHAZIR) return; SUREHAZIR=true;
  const gruplar={}; AR.sureler.forEach(r=>{ (gruplar[r.grup]=gruplar[r.grup]||[]).push(r); });
  $('#skural').innerHTML=Object.entries(gruplar).map(([g,rs])=>'<optgroup label="'+esc(g)+'">'+rs.map(r=>'<option value="'+esc(r.id)+'">'+esc(r.ad)+' — '+r.miktar+' '+({gun:'gün',hafta:'hafta',ay:'ay'})[r.birim]+'</option>').join('')+'</optgroup>').join('');
  const b=new Date(); $('#sbas').value=b.getFullYear()+'-'+String(b.getMonth()+1).padStart(2,'0')+'-'+String(b.getDate()).padStart(2,'0');
  $('#yorumbilgi').innerHTML='<p class="small" style="margin:0 0 6px"><b>'+esc(AR.yorum.kaynak)+', '+esc(AR.yorum.yer)+'</b> <span class="badge live">metinde birebir doğrulandı</span></p>'+
    '<p class="quote">(A) “'+esc(AR.yorum.a)+'”</p><p class="quote">(B) “'+esc(AR.yorum.b)+' … '+esc(AR.yorum.b2)+'”</p><p class="quote">(D) “'+esc(AR.yorum.d)+'”</p>'+
    '<p class="small muted" style="margin:6px 0 0"><a href="'+esc(AR.yorum.url)+'" target="_blank" rel="noopener">Resmî metin</a> · Resmî tatiller: '+esc(AR.tatil.kaynak)+' (<a href="'+esc(AR.tatil.url)+'" target="_blank" rel="noopener">metin</a>): '+AR.tatil.sabit.map(x=>esc(x[0].split('-').reverse().join('.')+' '+x[1])).join(', ')+'. '+esc(AR.tatil.degisken)+'</p>';
  ['#skural','#sbas'].forEach(s=>$(s).addEventListener('input',sureCiz));
  $('#statekle').addEventListener('click',()=>{ const t=$('#statyeni').value, ad=$('#statad').value.trim()||'Değişken tatil'; if(!t) return; DEGT=[...DEGT.filter(x=>x.t!==t),{t,ad}].sort((a,b)=>a.t.localeCompare(b.t)); yerel.koy(TKEY,DEGT); $('#statad').value=''; tatilCiz(); sureCiz(); });
  $('#statlist').addEventListener('click',e=>{ const b=e.target.closest('[data-sil]'); if(!b) return; DEGT=DEGT.filter(x=>x.t!==b.dataset.sil); yerel.koy(TKEY,DEGT); tatilCiz(); sureCiz(); });
  $('#sonuc').addEventListener('click',e=>{ const b=e.target.closest('[data-skaydet]'); if(!b || !SONHESAP) return;
    const L=yerel.al(SKEY,[]); L.push({id:Date.now().toString(36), ad:SONHESAP.r.ad, kaynak:(SONHESAP.r.src.p==='CMUK'?'CMUY ':'HMUT ')+SONHESAP.r.yer, bas:iso(SONHESAP.bas), son:iso(SONHESAP.h.son), not:$('#snot').value.trim()});
    yerel.koy(SKEY,L); $('#snot').value=''; listeCiz(); $('#skayitdurum').textContent='Listeye eklendi.'; });
  $('#elekle').addEventListener('click',()=>{ const t=$('#eltarih').value, n=$('#elnot').value.trim(); if(!t||!n) { $('#eldurum').textContent='Tarih ve açıklama yazın.'; return; }
    const L=yerel.al(SKEY,[]); L.push({id:Date.now().toString(36), ad:n, kaynak:'elle eklendi', son:t, not:''}); yerel.koy(SKEY,L); $('#elnot').value=''; $('#eldurum').textContent=''; listeCiz(); });
  $('#slist').addEventListener('click',e=>{ const b=e.target.closest('[data-ssil]'); if(!b) return; yerel.koy(SKEY,yerel.al(SKEY,[]).filter(x=>x.id!==b.dataset.ssil)); listeCiz(); });
  tatilCiz(); sureCiz(); listeCiz();
}
function tatilCiz(){
  $('#statsay').textContent=DEGT.length?DEGT.length+' gün eklendi':'eklenmedi';
  $('#statlist').innerHTML=DEGT.length?DEGT.map(x=>'<div class="trow"><span class="mno">'+esc(x.t.split('-').reverse().join('.'))+'</span><span>'+esc(x.ad)+'</span><button type="button" class="linkbtn" data-sil="'+esc(x.t)+'">Sil</button></div>').join(''):'<p class="muted small" style="margin:0">Henüz eklenmedi.</p>';
}
function sureCiz(){
  const r=AR.sureler.find(x=>x.id===$('#skural').value); if(!r) return;
  $('#sbaslab').textContent=r.bas;
  const v=$('#sbas').value; if(!v){ $('#sonuc').innerHTML=''; return; }
  const bas=tUTC(v), h=sureHesap(r,bas); SONHESAP={r,bas,h};
  const kal=kalanGun(iso(h.son));
  $('#sonuc').innerHTML='<div class="answer sure"><div class="lab">Son gün</div><div class="sonGun">'+esc(trd(h.son))+'</div><div class="'+(kal<0?'muted':kal<=3?'kirmizi':kal<=7?'sari':'muted')+' small" style="font-weight:600">'+kalanYazi(kal)+'</div>'+
    '<ol class="adim">'+h.adim.map(a=>'<li>'+esc(a)+'</li>').join('')+'</ol>'+
    h.uyari.map(u=>'<div class="check warn"><b>Dikkat.</b><span>'+esc(u)+'</span></div>').join('')+
    '<div class="dayanak"><div class="small"><b>Dayanak: '+esc(r.src.kaynak)+', '+esc(r.yer)+'</b> <span class="badge live">metinde birebir doğrulandı</span></div><p class="quote">“…'+esc(r.alinti)+'…”</p><p class="small muted" style="margin:0">'+esc(r.not)+(r.src.url?' · <a href="'+esc(r.src.url)+'" target="_blank" rel="noopener">resmî metin</a>':'')+'</p></div>'+
    '<div class="row" style="margin-top:12px"><input type="text" id="snot" placeholder="Dosya no veya kısa not (yalnızca bu cihazda tutulur)" style="flex:1;min-width:180px"><button class="btn sm" type="button" data-skaydet>Süre listeme ekle</button><span class="state small" id="skayitdurum"></span></div>'+
    '<p class="small muted" style="margin:10px 0 0">Hesap, resmî metinlerdeki kurallara göre yapılır; mahkemenin süre uzatma kararları, özel yasa kuralları ve tebliğ tarihinin doğruluğu avukatın kontrolündedir.</p></div>';
}
function listeCiz(){
  const L=yerel.al(SKEY,[]).sort((a,b)=>a.son.localeCompare(b.son));
  $('#slist').innerHTML=L.length?L.map(x=>{ const k=kalanGun(x.son); return '<div class="srow'+(k<0?' gecti':'')+'"><div><div><b>'+esc(tUTC(x.son).toLocaleDateString('tr-TR',{timeZone:'UTC',day:'numeric',month:'long',year:'numeric',weekday:'short'}))+'</b> · <span class="'+(k<0?'muted':k<=3?'kirmizi':k<=7?'sari':'muted')+'">'+kalanYazi(k)+'</span></div><div class="small">'+esc(x.ad)+(x.not?' · <b>'+esc(x.not)+'</b>':'')+'</div><div class="small muted">'+esc(x.kaynak)+(x.bas?' · başlangıç '+esc(x.bas.split('-').reverse().join('.')):'')+'</div></div><button type="button" class="linkbtn" data-ssil="'+esc(x.id)+'">Sil</button></div>'; }).join('')
    :'<p class="muted small" style="margin:0">Kaydettiğiniz süreler ve duruşma tarihleri burada, en yakın tarihten başlayarak sıralanır. Bilgiler yalnızca bu cihazdaki tarayıcıda tutulur.</p>';
}

/* ---------- ortak: kaynak kartları ve atıf düğmeleri (taslak ve dosya bölümleri) ---------- */
document.addEventListener('click',e=>{ const b=e.target.closest('.cite[data-p]'); if(!b) return; const el=document.getElementById(b.dataset.p+b.dataset.no); if(!el) return;
  el.classList.add('open'); const ac=el.querySelector(':scope > .ac'); if(ac) ac.textContent='Kapat';
  el.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'}); el.classList.add('flash'); setTimeout(()=>el.classList.remove('flash'),1400); });
const citeBtn = (c,p) => '<button class="cite" type="button" contenteditable="false" data-p="'+p+'" data-no="'+esc(c)+'">'+esc(etiket(c))+'</button>';
function bilinmeyenAtif(metin, list){
  const lawsIn=new Set(list.map(a=>a.law)), known=new Set(); list.forEach(a=>{ const L=LAWBY[a.law]; (L&&L.arts?L.arts:ARTS.filter(x=>x.law===a.law)).forEach(x=>known.add(String(x.no))); });
  const refs=[...String(metin).matchAll(/(?:madde\s*(\d+)|(\d+)\s*['’]?(?:\.|inci|ıncı|üncü|ncı|nci|uncu)?\s*madde)/gi)].map(m=>m[1]||m[2]);
  return [...new Set(refs.filter(n=>!known.has(n)))];
}
function gizleVeSakla(metin, ek){ const eski=MAP; const r=maskAll(metin, ek||''); const harita=MAP; MAP=eski; return {text:r.text, counts:r.counts, harita}; }
const ac_ = (s, h) => String(s).replace(/\[(KİŞİ|ŞİRKET|KİMLİK|TELEFON|E-POSTA|IBAN|ADRES|DOĞUM TARİHİ|EK)-\d+\]/g, m=>h[m]||m);

/* ---------- belge taslağı ---------- */
const SERBEST=[
  ['talep','Talep takriri (dava dilekçesi)','Davacının olayları ve istediği çareleri numaralı paragraflarla anlattığı layiha.'],
  ['mudafaa','Müdafaa takriri (savunma)','Talep takririne paragraf paragraf cevap: kabul edilen, inkâr edilen olaylar ve karşı iddialar.'],
  ['istida','İstida ve destekleyici yemin takriri','Ara emri veya başka bir çare için başvuru; dayanılan olaylar yemin takririnde anlatılır.'],
  ['ihtar','İhtarname','Karşı tarafa yazılı ihtar: olaylar, talep, verilen süre ve sonuçları.'],
  ['gorus','Müvekkile hukuki değerlendirme yazısı','İlgili mevzuata dayanan değerlendirme, riskler ve seçenekler.'],
  ['sozlesme','Sözleşme taslağı','Tarafların anlaştığı koşullara göre sözleşme; yasanın zorunlu kuralları kaynaklı.'],
];
let FORMLAR=null, TASLAKHAZIR=false, tctl=null, TSON=null;
async function taslakInit(){
  if(TASLAKHAZIR) return; TASLAKHAZIR=true;
  const ciz=()=>{ $('#tturu').innerHTML='<optgroup label="Serbest belge">'+SERBEST.map(s=>'<option value="s:'+s[0]+'">'+esc(s[1])+'</option>').join('')+'</optgroup>'+
    (FORMLAR?'<optgroup label="HMUT formları ('+FORMLAR.formlar.length+')">'+FORMLAR.formlar.map((f,i)=>'<option value="f:'+i+'">Form '+esc(f.no)+' — '+esc(f.baslik.length>90?f.baslik.slice(0,90)+'…':f.baslik)+'</option>').join('')+'</optgroup>':''); turBilgi(); };
  ciz();
  $('#tturu').addEventListener('change',turBilgi);
  try{ FORMLAR=await fetch('formlar.json').then(r=>{ if(!r.ok) throw new Error(r.status); return r.json(); }); const s=$('#tturu').value; ciz(); $('#tturu').value=s; }
  catch(_){ $('#tform').textContent='HMUT formları yüklenemedi; serbest belge türleri kullanılabilir.'; }
}
function secilenTur(){ const v=$('#tturu').value||'s:talep'; if(v.startsWith('f:')&&FORMLAR) { const f=FORMLAR.formlar[+v.slice(2)]; return {form:f, ad:'HMUT Form '+f.no+' — '+f.baslik}; } const s=SERBEST.find(x=>'s:'+x[0]===v)||SERBEST[0]; return {ad:s[1], aciklama:s[2]}; }
function turBilgi(){ const t=secilenTur();
  $('#tform').innerHTML = t.form ? '<details class="sheet"><summary><span class="t">Form '+esc(t.form.no)+' kalıbı'+(t.form.emir?' · '+esc(t.form.emir):'')+'</span><span class="muted small">resmî metin</span></summary><pre class="gtxt" style="max-height:300px;margin-top:8px">'+esc(t.form.metin)+'</pre><p class="small muted" style="margin:6px 0 0">Kaynak: '+esc(FORMLAR.kaynak)+' · <a href="'+esc(FORMLAR.url)+'" target="_blank" rel="noopener">resmî dosya</a></p></details>'
    : '<p class="small muted" style="margin:0">'+esc(t.aciklama||'')+'</p>'; }
function taslakIstem(t, mah, taraf, olay, list){
  const ids=list.map(a=>a.cid).join(', ');
  return `Sen KKTC'de çalışan bir avukat için belge taslağı hazırlıyorsun. Belge türü: ${t.ad}.
${t.form?`Aşağıdaki resmî HMUT kalıbını (Form ${t.form.no}) esas al: başlıkları, sıralamayı ve kalıp ifadelerini koru; noktalı boşlukları ve (a), (b) gibi işaretli yerleri kullanıcının verdiği bilgilerle doldur; bilgi yoksa [....] bırak.

FORM METNİ:
${t.form.metin}
`:''}
KULLANICININ BİLGİLERİ:
Mahkeme: ${mah||'[belirtilmedi]'}
Taraflar: ${taraf||'[belirtilmedi]'}
Olaylar ve talep:
${olay}

KURALLAR:
1. Olay, tarih, tutar ve adları YALNIZCA kullanıcının bilgilerinden al; uydurma. Eksik bilgiyi [....] ile boş bırak ve "doldurulacak" listesine yaz.
2. Kişi bilgileri [KİŞİ-1] gibi etiketlerle gizlendi; etiketleri aynen kullan, gerçek adı tahmin etme.
3. Bir hukuk kuralına, yasaya, tüzüğe veya maddeye dayanan her paragrafa "cites" alanında aşağıdaki kimliklerden en az birini yaz. Yalnızca şu kimlikleri kullan: ${ids||'yok'}. Aşağıdaki metinlerde bulunmayan bir kural, madde numarası veya Emir/nizam numarası yazma. Türkiye mevzuatını (TBK, HMK, İİK vb.) kullanma.
4. KKTC uygulamasındaki terimleri kullan (celpname, talep takriri, müdafaa takriri, istida, yemin takriri, mukayyit, Kaza Mahkemesi, davacı, davalı).
5. Talep ve müdafaa takrirlerinde ve yemin takririnde paragrafları numarala (1., 2., 3.). Sade, resmî Türkçe kullan.
6. Hukuki görüş veya sonuç garantisi verme. Avukatın kontrol etmesi gereken noktaları "uyarilar" alanına yaz.

METİNLER:
${maddeBloklari(list)||'(ilgili madde bulunamadı)'}

Yalnızca şu biçimde JSON döndür:
{"baslik":"belgenin başlığı","bolumler":[{"baslik":"bölüm başlığı (yoksa boş)","paragraflar":[{"metin":"...","cites":["KIMLIK"]}]}],"doldurulacak":["eksik bilgi"],"uyarilar":"avukatın kontrol etmesi gerekenler"}`;
}
function taslakCiz(res, list, harita){
  const allowed=new Set(list.map(a=>a.cid)); let kaynaksiz=0; const hepsi=[];
  const bol=(Array.isArray(res.bolumler)?res.bolumler:[]).map(b=>({baslik:String(b&&b.baslik||''), p:(Array.isArray(b&&b.paragraflar)?b.paragraflar:[]).map(p=>{
    const metin=ac_(String(p&&p.metin||''),harita), cites=(Array.isArray(p&&p.cites)?p.cites:[]).map(String).filter(c=>allowed.has(c));
    const hukuki=/(^|[^\p{L}])(madde|yasa|tüzü|emir|emri|nizam|fasıl)/iu.test(metin); if(hukuki && !cites.length) kaynaksiz++; hepsi.push(metin); return {metin, cites, hukuki};
  })})).filter(b=>b.p.length);
  const unk=bilinmeyenAtif(hepsi.join(' '), list);
  let h='<div class="answer"><div class="belge" id="tbelge" contenteditable="true" spellcheck="true"><h2 data-w="h1">'+esc(ac_(res.baslik||secilenTur().ad,harita))+'</h2>'+
    bol.map(b=>(b.baslik?'<h3 data-w="h2">'+esc(ac_(b.baslik,harita))+'</h3>':'')+b.p.map(p=>'<p data-w="p">'+esc(p.metin)+(p.cites.length?' '+p.cites.map(c=>citeBtn(c,'t-')).join(''):p.hukuki?' <span class="badge gone" contenteditable="false">kaynak gösterilmedi</span>':'')+'</p>').join('')).join('')+'</div>';
  const dold=(Array.isArray(res.doldurulacak)?res.doldurulacak:[]).map(String).filter(Boolean);
  if(dold.length) h+='<div class="check warn"><b>Doldurulacak:</b><span>'+dold.map(d=>esc(ac_(d,harita))).join(' · ')+'</span></div>';
  if(res.uyarilar) h+='<div class="check warn"><b>Kontrol edin:</b><span>'+esc(ac_(res.uyarilar,harita))+'</span></div>';
  if(unk.length) h+='<div class="check bad"><b>Var olmayan madde atfı: '+esc(unk.join(', '))+'.</b><span>Bulunan yasalarda bu numaralı madde yok; düzeltin.</span></div>';
  if(kaynaksiz) h+='<div class="check bad"><b>'+kaynaksiz+' paragrafta hukuki dayanak var ama kaynak gösterilmedi.</b><span>İşaretli paragrafları resmî metinden kontrol edin.</span></div>';
  if(!unk.length && !kaynaksiz) h+='<div class="check ok"><b>Kaynak kontrolü geçti.</b><span>Hukuki dayanak içeren paragrafların hepsi bulunan maddelere bağlı; var olmayan madde numarası yok.</span></div>';
  h+='<p class="small muted" style="margin:10px 0 0">Taslağın üzerinde doğrudan düzeltme yapabilirsiniz; Word çıktısı yaptığınız düzeltmeleri içerir, atıf etiketlerini içermez.</p><div class="acts"><button class="btn sm" type="button" id="tword">Word olarak indir</button><button class="btn ghost sm" type="button" id="tkopya">Kopyala</button><span class="state small" id="tdurum"></span></div></div>';
  $('#tcikti').innerHTML=h;
  $('#tkaynak').innerHTML=list.length?list.map(a=>sheet(a,'article','t-')).join(''):'<p class="muted small">İlgili madde bulunamadı.</p>';
  rvStats();
}
function belgeBloklari(){
  const B=[]; document.querySelectorAll('#tbelge > *').forEach(el=>{ const c=el.cloneNode(true); c.querySelectorAll('.cite,.badge').forEach(x=>x.remove()); const t=c.innerText.replace(/ /g,' ').trim(); if(!t) return;
    B.push({tur:{h1:'h1',h2:'h2'}[el.dataset.w]||(el.tagName==='H2'?'h1':el.tagName==='H3'?'h2':'p'), metin:t}); });
  return B;
}
$('#pane-taslak').addEventListener('click',async e=>{
  if(e.target.id==='tword'){ const B=belgeBloklari(); $('#tdurum').textContent='Hazırlanıyor…'; const r=await indir(dosyaAdi((B[0]&&B[0].metin)||'Taslak')+'.docx', docx((B[0]&&B[0].metin)||'Taslak',B)); $('#tdurum').textContent=indirMesaj(r)||'Word dosyası indirildi.'; }
  if(e.target.id==='tkopya') kopyala(belgeBloklari().map(b=>b.metin).join('\n\n'), $('#tdurum'));
});
$('#thazirla').addEventListener('click',async()=>{
  const olay=$('#tolay').value.trim(); if(olay.length<20){ $('#tstate').textContent='Olayları ve talebi biraz daha ayrıntılı yazın.'; return; }
  if(!sampleFn){ $('#tstate').textContent='Yapay zekâ bu görünümde kullanılamıyor.'; return; }
  const t=secilenTur(), mah=$('#tmah').value.trim(), taraf=$('#ttaraf').value.trim();
  let harita={}, tarafG=taraf, olayG=olay;
  if($('#tgizle').checked){ const ek=taraf.split(/[,;\n·]|(?:\s+-\s+)/).map(s=>s.replace(/^(davacı|davalı|müvekkil|karşı taraf|kiracı|kiraya veren|alıcı|satıcı)\s*[:\-]?\s*/i,'').trim()).filter(s=>/^\p{Lu}/u.test(s) && s.split(/\s+/).length>=2 && s.length<60).join(',');
    const r=gizleVeSakla('TARAFLAR: '+taraf+'\n@@@\n'+olay, ek); harita=r.harita; const [a,b]=r.text.split('\n@@@\n'); tarafG=a.replace(/^TARAFLAR: /,''); olayG=b; }
  tctl=new AbortController(); $('#thazirla').disabled=true; $('#tdur').hidden=false; $('#tstate').textContent='İlgili maddeler aranıyor…';
  try{
    const list=await cokluAra([(t.form?t.form.baslik+' ':'')+olay.slice(0,400), olay.slice(0,200)], 9, s=>$('#tstate').textContent=s);
    $('#tkaynak').innerHTML=list.map(a=>sheet(a,'article','t-')).join(''); $('#tstate').textContent='Taslak yazılıyor…'+(Object.keys(harita).length?' ('+Object.keys(harita).length+' kişisel bilgi gizlendi)':'');
    const res=await sampleFn.json(taslakIstem(t,mah,tarafG,olayG,list),{signal:tctl.signal, modelTier:'default'});
    TSON={res,list,harita}; taslakCiz(res||{}, list, harita); $('#tstate').textContent='';
  }catch(e){ $('#tstate').textContent=hataMesaj(e); }
  finally{ $('#thazirla').disabled=false; $('#tdur').hidden=true; }
});
$('#tdur').addEventListener('click',()=>tctl&&tctl.abort());

/* ---------- sözleşme inceleme (dosya bölümü) ---------- */
let RSON=null;
function riskIstem(tur, list){
  const body=MASKED.map(p=>'[SAYFA '+p.page+']\n'+p.text).join('\n\n');
  return `Bir KKTC avukatı için aşağıdaki sözleşmeyi incele (tür: ${tur||'belirtilmedi'}). Kişi bilgileri [KİŞİ-1] gibi etiketlerle gizlendi; etiketleri aynen kullan.

KURALLAR:
1. "riskler": sözleşmedeki bir hükmün müvekkil açısından sorunlu, belirsiz veya tek taraflı olduğu yerler. Her risk için sözleşmeden BİREBİR kopyalanmış 6-25 kelimelik alıntı ("quote") ve sayfa numarası ("page") ver.
2. Risk KKTC mevzuatına aykırılık veya uyumsuzluk içeriyorsa "cites" alanına aşağıdaki kimliklerden ilgili olanları yaz. Yalnızca şu kimlikler: ${list.map(a=>a.cid).join(', ')||'yok'}. Mevzuata dayanmayan ticari riskler için "cites": [] bırak.
3. "eksikler": yasanın zorunlu kıldığı veya taraf için önemli olup sözleşmede bulunmayan hükümler. Yasal bir zorunluluğa dayanıyorsa mutlaka "cites" ver.
4. Yalnızca aşağıdaki metinlere ve sözleşmeye dayan; Türkiye mevzuatı (TBK vb.) kullanma; metinlerde olmayan madde numarası yazma.
5. "derece": "yüksek", "orta" veya "düşük". "oneri": hükmün nasıl değiştirilebileceğine dair kısa öneri. Hukuki görüş veya sonuç garantisi verme.

METİNLER:
${maddeBloklari(list)||'(ilgili madde bulunamadı)'}

SÖZLEŞME:
${body}

Yalnızca şu JSON'u döndür:
{"tur":"sözleşmenin türü","ozet":"2-3 cümle: taraflar ve ana edimler","riskler":[{"baslik":"...","aciklama":"...","quote":"...","page":1,"cites":[],"derece":"orta","oneri":"..."}],"eksikler":[{"text":"...","cites":[]}],"limits":"incelemenin kapsamadığı veya avukatın ayrıca bakması gereken noktalar"}`;
}
function riskCiz(){
  if(!RSON) return; const {res,list}=RSON; const allowed=new Set(list.map(a=>a.cid));
  const DER={yüksek:'gone',orta:'chg',düşük:'live'}; let bad=0, n=0, atilan=0;
  const R=(Array.isArray(res.riskler)?res.riskler:[]).map(r=>({...r, cites:(Array.isArray(r.cites)?r.cites:[]).map(String).filter(c=>allowed.has(c))}));
  R.sort((a,b)=>['yüksek','orta','düşük'].indexOf(a.derece)-['yüksek','orta','düşük'].indexOf(b.derece));
  const E=(Array.isArray(res.eksikler)?res.eksikler:[]).map(x=>({text:String(x&&x.text||''), cites:(Array.isArray(x&&x.cites)?x.cites:[]).map(String).filter(c=>allowed.has(c)), ham:(Array.isArray(x&&x.cites)?x.cites.length:0)}))
    .filter(x=>{ if(x.ham && !x.cites.length){ atilan++; return false; } return x.text; });
  let h='<div class="answer"><h2>Sözleşme incelemesi'+(res.tur?' · '+esc(unmask(res.tur)):'')+'</h2>'+(res.ozet?'<p>'+esc(unmask(res.ozet))+'</p>':'')+
    '<ul class="points">'+R.map(r=>{ n++; const v=locate(r.quote||'',r.page); if(v.ok==='bad') bad++;
      return '<li><b>'+esc(unmask(r.baslik||'Risk'))+'</b> <span class="badge '+(DER[r.derece]||'chg')+'">'+esc(r.derece||'?')+'</span><div>'+esc(unmask(r.aciklama||''))+(r.cites.length?' '+r.cites.map(c=>citeBtn(c,'f-')).join(''):' <span class="muted small">(mevzuat dayanağı yok: ticari değerlendirme)</span>')+'</div>'+
        (r.oneri?'<div class="small" style="margin-top:3px"><b>Öneri:</b> '+esc(unmask(r.oneri))+'</div>':'')+'<div class="small muted" style="margin-top:3px">s. '+esc(r.page)+' · “'+esc(unmask(r.quote||''))+'” '+vBadge(v)+'</div></li>'; }).join('')+'</ul>';
  if(E.length) h+='<h2 style="margin-top:14px;font-size:17px">Eksik görünen hükümler</h2><ul class="points">'+E.map(x=>'<li>'+esc(unmask(x.text))+(x.cites.length?' '+x.cites.map(c=>citeBtn(c,'f-')).join(''):'')+'</li>').join('')+'</ul>';
  if(res.limits) h+='<p class="small muted" style="margin-top:10px"><b>Ayrıca kontrol edin:</b> '+esc(unmask(res.limits))+'</p>';
  h+= bad ? '<div class="check bad"><b>'+bad+' / '+n+' alıntı sözleşmede bulunamadı.</b><span>Bu riskleri asıl metinden kontrol edin.</span></div>' : n ? '<div class="check ok"><b>Alıntı kontrolü geçti.</b><span>'+n+' riskin alıntısı sözleşmede bulundu.</span></div>' : '';
  if(atilan) h+='<div class="check warn"><b>'+atilan+' eksik hüküm tespiti gösterilmedi.</b><span>Geçerli bir mevzuat kaynağı gösterilemedi.</span></div>';
  h+='<div class="acts"><button class="btn ghost sm" type="button" id="rword">Word olarak indir</button><span class="state small" id="rdurum"></span></div></div>';
  h+='<details class="sheet" style="margin-top:12px"><summary><span class="t">Dayanılan maddeler ('+list.length+')</span></summary><div class="col" style="gap:8px;margin-top:8px">'+list.map(a=>sheet(a,'article','f-')).join('')+'</div></details>';
  $('#sumout').innerHTML=h; rvStats();
  $('#rword').onclick=async()=>{ const B=[{tur:'h1',metin:'Sözleşme İncelemesi'},{tur:'kucuk',metin:bugunStr()+' · KKTC Hukuk Asistanı'}];
    if(res.tur) B.push({tur:'p',kalin:true,metin:unmask(res.tur)}); if(res.ozet) B.push({tur:'p',metin:unmask(res.ozet)});
    B.push({tur:'h2',metin:'Riskler'}); R.forEach(r=>{ B.push({tur:'p',kalin:true,metin:unmask(r.baslik||'Risk')+' ('+(r.derece||'?')+')'}); B.push({tur:'p',metin:unmask(r.aciklama||'')+(r.cites.length?' ['+r.cites.map(etiket).join('; ')+']':'')}); if(r.quote) B.push({tur:'alinti',metin:'s. '+r.page+': “'+unmask(r.quote)+'”'}); if(r.oneri) B.push({tur:'p',metin:'Öneri: '+unmask(r.oneri)}); });
    if(E.length){ B.push({tur:'h2',metin:'Eksik görünen hükümler'}); E.forEach(x=>B.push({tur:'p',metin:'• '+unmask(x.text)+(x.cites.length?' ['+x.cites.map(etiket).join('; ')+']':'')})); }
    if(res.limits) B.push({tur:'p',metin:'Ayrıca kontrol edin: '+unmask(res.limits)});
    B.push({tur:'kucuk',metin:'Yapay zekâ yardımıyla hazırlanmış kontrol listesidir; hukuki görüş değildir.'});
    $('#rdurum').textContent='Hazırlanıyor…'; const r=await indir('Sozlesme incelemesi.docx', docx('Sözleşme İncelemesi',B)); $('#rdurum').textContent=indirMesaj(r)||'Word dosyası indirildi.'; };
}
$('#risk').addEventListener('click',async()=>{
  doMask();
  if(!MASKED.length || !MASKED.some(p=>p.text.length>20)){ $('#sstate').textContent='Önce bir sözleşme ekleyin.'; return; }
  if(!sampleFn){ $('#sstate').textContent='Yapay zekâ bu görünümde kullanılamıyor.'; return; }
  fctl=new AbortController(); $('#risk').disabled=true; $('#summ').disabled=true; $('#fstop').hidden=false; $('#sstate').textContent='Sözleşmenin türü ve ilgili konular belirleniyor…';
  try{
    const body=MASKED.map(p=>p.text).join('\n\n');
    const plan=await sampleFn.json(`Aşağıdaki sözleşmenin türünü belirle ve KKTC mevzuatında aranması gereken konuları 3-5 kısa arama ifadesiyle yaz (KKTC terimleriyle; Türkiye mevzuatı terimleri değil).\nYalnızca JSON: {"tur":"...","ara":["...","..."]}\n\nSÖZLEŞME (başı):\n${body.slice(0,12000)}`,{signal:fctl.signal});
    const ara=(Array.isArray(plan&&plan.ara)?plan.ara:[]).map(String).slice(0,5);
    const list=await cokluAra([String(plan&&plan.tur||'sözleşme'), ...ara], 14, s=>$('#sstate').textContent=s);
    $('#sstate').textContent='Sözleşme maddelerle karşılaştırılıyor…';
    const res=await sampleFn.json(riskIstem(plan&&plan.tur, list),{signal:fctl.signal, modelTier:'default'});
    LAST=null; RSON={res:res||{}, list}; riskCiz(); $('#sstate').textContent='';
  }catch(e){ $('#sstate').textContent=hataMesaj(e); }
  finally{ $('#risk').disabled=false; $('#summ').disabled=false; $('#fstop').hidden=true; }
});
$('#summ').addEventListener('click',()=>{ RSON=null; });
$('#reveal').addEventListener('change',()=>{ if(RSON && !LAST) riskCiz(); });
